{
  "productName": "Jam Reborn",
  "electronVersion": "32.0.1",
  "directories": {
    "output": "build"
  },
  "mac": {
    "files": ["src/**/*"],
    "asar": "true",
    "target": { "target": "dmg", "arch": ["x64"] },
    "icon": "./assets/icon.png",
    "artifactName": "Jam-Reborn.${ext}"
  },
  "win": {
    "files": ["src/**/*"],
    "icon": "./assets/icon.ico",
    "asar": "true",
    "target": { "target": "nsis", "arch": ["x64"] },
    "artifactName": "Jam-Reborn-Setup.${ext}"
  },
  "extraFiles": [
    "plugins/**/*",
    "assets/**/*",
    "public/**/*",
    "settings.json"
  ],
  "extraResources": ["assets/", "public/"],
  "publish": { "provider": "github", "releaseType": "release" }
}